import pandas as pd
import numpy as np
import os

RAW = 'data/raw/sample_health.csv'
CLEAN = 'data/processed/clean_health.csv'


def load_health(path=RAW):
    return pd.read_csv(path, parse_dates=['admission_date','discharge_date'])


def summarize(df: pd.DataFrame):
    miss = df.isnull().sum().rename('missing')
    pct = (df.isnull().mean()*100).rename('pct')
    return pd.concat([miss,pct],axis=1)


def impute_health(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    # Age: fill with median
    if 'age' in df.columns:
        df['age'] = df['age'].fillna(df['age'].median()).astype(int)
    # Labs: fill with median
    for c in ['lab_result_1','lab_result_2']:
        if c in df.columns:
            df[c] = df[c].replace(0, np.nan)
            df[c] = df[c].fillna(df[c].median())
    # medication_count: fill 0
    if 'medication_count' in df.columns:
        df['medication_count'] = df['medication_count'].fillna(0).astype(int)
    return df


def feature_engineer_health(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df['length_of_stay'] = (df['discharge_date'] - df['admission_date']).dt.days
    df['age_group'] = pd.cut(df['age'], bins=[0,18,35,50,65,80,120], labels=['0-18','19-35','36-50','51-65','66-80','80+'])
    df['high_comorbidity'] = df['comorbidities_count'] >= 3
    df['lab_ratio'] = df['lab_result_1'] / (df['lab_result_2'] + 1e-6)
    df['is_readmit'] = df['readmitted'] == 1
    return df


def save_clean(df: pd.DataFrame, path=CLEAN):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    df.to_csv(path, index=False)


if __name__ == '__main__':
    df = load_health()
    print('Missing summary:\n', summarize(df))
    df = impute_health(df)
    df = feature_engineer_health(df)
    save_clean(df)
    print('Saved cleaned health data to', CLEAN)
